/* pages/garden/my-tasks.wxss */

.my-tasks-page {
  min-height: 100vh;
  background: #F0FAF2;
  padding-bottom: 40rpx;
}

/* ── Loading / Error ── */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #B7E4C7;
  border-top-color: #43A047;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: #43A047;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.8;
}

/* ── ① Tab 切换栏 ── */
.tab-bar {
  display: flex;
  background: white;
  border-bottom: 2rpx solid #E8F5E9;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.tab-active .tab-text {
  color: #1B4332;
  font-weight: 700;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 24%;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  background: #E53935;
  color: white;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.badge-gray {
  background: #999;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 6rpx;
  background: #43A047;
  border-radius: 3rpx;
}

/* ── ② 记录列表 ── */
.record-list {
  padding: 16rpx 24rpx 0;
}

/* ── 记录卡片 ── */
.record-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-claimed {
  border-left: 6rpx solid #FF7043;
}

.card-submitted {
  border-left: 6rpx solid #457B9D;
}

.card-approved {
  border-left: 6rpx solid #43A047;
}

.card-rejected {
  border-left: 6rpx solid #E53935;
}

.card-header {
  display: flex;
  align-items: center;
}

.card-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.claimed-icon-bg {
  background: #FFF3E0;
}

.submitted-icon-bg {
  background: #E6F4FF;
}

.approved-icon-bg {
  background: #E8F5E9;
}

.rejected-icon-bg {
  background: #FFEBEE;
}

.card-icon {
  font-size: 30rpx;
}

.card-title-area {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.card-points {
  font-size: 26rpx;
  font-weight: 700;
  color: #43A047;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 截止时间 */
.card-deadline-area {
  flex: 1;
}

.card-deadline {
  font-size: 22rpx;
  color: #999;
}

.deadline-urgent {
  color: #E53935;
  font-weight: 600;
}

/* 照片缩略图 */
.card-photos {
  margin-top: 16rpx;
}

.photos-scroll {
  white-space: nowrap;
}

.photos-row {
  display: inline-flex;
  gap: 12rpx;
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F5F5F5;
}

/* 按钮 */
.card-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
}

.btn-submit {
  background: #43A047;
  color: white;
}

.btn-submit:active {
  opacity: 0.8;
}

/* 状态标签 */
.card-status-label {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-submitted {
  background: #E6F4FF;
  color: #457B9D;
}

/* 驳回原因 */
.reject-reason {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFEBEE;
  border-radius: 12rpx;
}

.reject-label {
  font-size: 22rpx;
  color: #E53935;
  font-weight: 600;
}

.reject-text {
  font-size: 22rpx;
  color: #9B2335;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ── ③ 提交弹窗 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-body {
  width: 100%;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.modal-task-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.modal-section {
  margin-bottom: 24rpx;
}

.modal-section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.photo-count {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

/* 照片选择区 */
.modal-photos {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.modal-photo-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.modal-photo-img {
  width: 100%;
  height: 100%;
}

.modal-photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.modal-photo-del:active {
  background: rgba(0, 0, 0, 0.7);
}

.modal-photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #B7E4C7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F0FAF2;
}

.modal-photo-add:active {
  background: #E8F5E9;
}

.add-icon {
  font-size: 48rpx;
  color: #43A047;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #43A047;
  margin-top: 4rpx;
}

/* 备注输入 */
.modal-note-input {
  width: 100%;
  height: 140rpx;
  padding: 16rpx;
  font-size: 26rpx;
  border: 2rpx solid #E8F5E9;
  border-radius: 16rpx;
  background: #FAFAFA;
  box-sizing: border-box;
}

/* 提交按钮 */
.modal-submit-btn {
  text-align: center;
  padding: 24rpx 0;
  background: #43A047;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.modal-submit-btn:active {
  opacity: 0.8;
}

.btn-loading {
  background: #B7E4C7;
}
