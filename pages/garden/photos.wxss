/* pages/garden/photos.wxss */

.photos-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F0FAF2 30%, #E6F4FF 100%);
  padding-bottom: 120rpx;
}

/* ── Loading ── */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #B7E4C7;
  border-top-color: #43A047;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ── Error ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: #43A047;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* ── ① 统计栏 ── */
.stats-bar {
  padding: 28rpx 32rpx;
  background: white;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stats-text {
  font-size: 28rpx;
  color: #2D6A4F;
  font-weight: 500;
}

/* ── 空状态 ── */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ── ② 时间轴 ── */
.timeline {
  padding: 24rpx;
}

.week-group {
  margin-bottom: 32rpx;
}

.week-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.week-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #40916C;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 6rpx rgba(64, 145, 108, 0.2);
}

.week-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1B4332;
}

/* ── 照片网格 ── */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding-left: 36rpx;
  border-left: 4rpx solid #D8F3DC;
  margin-left: 9rpx;
}

.photo-card {
  background: white;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.photo-img {
  width: 100%;
  height: 280rpx;
}

.photo-info {
  padding: 12rpx 16rpx;
}

.photo-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #2D6A4F;
}

.photo-caption {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── ③ 全屏预览 ── */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 80vh;
}

.preview-footer {
  padding: 20rpx 40rpx;
  text-align: center;
}

.preview-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.preview-caption {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ── ④ FAB 上传按钮 ── */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #40916C;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(64, 145, 108, 0.4);
  z-index: 100;
}

.fab-btn:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 48rpx;
  color: white;
  font-weight: 300;
  line-height: 1;
}

.fab-uploading {
  background: #999;
}

.fab-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}