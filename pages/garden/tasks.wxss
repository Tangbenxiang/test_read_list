/* pages/garden/tasks.wxss */

.tasks-page {
  min-height: 100vh;
  background: #F0FAF2;
  padding-bottom: 40rpx;
}

/* ── Loading / Error ── */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #B7E4C7;
  border-top-color: #43A047;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: #43A047;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.8;
}

/* ── ① 顶部状态栏 ── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: white;
  border-bottom: 2rpx solid #E8F5E9;
}

.week-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #1B4332;
}

.mini-health-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-health-bg {
  width: 160rpx;
  height: 14rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 7rpx;
  overflow: hidden;
}

.mini-health-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}

.mini-health-text {
  font-size: 24rpx;
  font-weight: 700;
}

/* ── Section 通用 ── */
.section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1B4332;
}

.section-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.tag-required {
  background: #FEE2E2;
  color: #E53935;
}

.tag-optional {
  background: #E6F4FF;
  color: #457B9D;
}

/* ── ② 任务卡片 ── */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.2s;
}

.task-card:active {
  opacity: 0.9;
}

/* 左边框强调 */
.task-required {
  border-left: 6rpx solid #E53935;
}

.task-optional {
  border-left: 6rpx solid #457B9D;
}

/* 已认领状态降低透明度 */
.task-claimed {
  opacity: 0.7;
}

.task-main {
  display: flex;
  align-items: center;
}

.task-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.task-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.required-icon-bg {
  background: #FEE2E2;
}

.optional-icon-bg {
  background: #E6F4FF;
}

.task-icon {
  font-size: 34rpx;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-time {
  font-size: 22rpx;
  color: #999;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.task-hp {
  font-size: 26rpx;
  font-weight: 700;
}

.task-deadline {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

/* ── 任务底部 ── */
.task-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F5F5F5;
}

.task-claim-text {
  font-size: 22rpx;
  color: #999;
}

.task-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 32rpx;
  border-radius: 24rpx;
}

.btn-claim {
  background: #43A047;
  color: white;
}

.btn-claim:active {
  opacity: 0.8;
}

.btn-claim-optional {
  background: #457B9D;
  color: white;
}

.btn-claim-optional:active {
  opacity: 0.8;
}

.btn-claimed {
  background: #F5F5F5;
  color: #999;
}

.btn-full {
  background: #F5F5F5;
  color: #BBB;
}

/* ── 空状态 ── */
.empty-all {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* ── 详情弹窗 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-body {
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.modal-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.modal-icon {
  font-size: 32rpx;
}

.modal-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.modal-info {
  padding: 24rpx 32rpx;
}

.modal-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F8F8F8;
}

.modal-info-row:last-child {
  border-bottom: none;
}

.modal-info-label {
  font-size: 26rpx;
  color: #999;
}

.modal-info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.text-required {
  color: #E53935;
  font-weight: 600;
}

.text-optional {
  color: #457B9D;
  font-weight: 600;
}

.modal-footer {
  padding: 0 32rpx 32rpx;
}

.modal-close-btn {
  text-align: center;
  padding: 20rpx 0;
  background: #F5F5F5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.modal-close-btn:active {
  background: #EBEBEB;
}
